{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizeasy.local/schema/quizeasy-set.schema.json",
  "title": "Quizeasy Set Export",
  "type": "object",
  "required": ["format", "schemaVersion", "exportedAt", "set", "questions"],
  "properties": {
    "format": {
      "const": "quizeasy-set"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "exportedAt": {
      "type": "string"
    },
    "set": {
      "type": "object",
      "required": ["id", "title", "createdAt", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "lastStudiedAt": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "setId",
          "prompt",
          "answer",
          "acceptedAnswers",
          "wrongChoices",
          "tags",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "setId": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "acceptedAnswers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wrongChoices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
