{
  "name": "quizeasy",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source, local-first quiz maker and study app. Paste questions, review the import, start studying.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "quiz",
    "flashcards",
    "study",
    "local-first",
    "offline",
    "spaced-repetition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberSphinxxx/Quizeasy.git"
  },
  "bugs": {
    "url": "https://github.com/CyberSphinxxx/Quizeasy/issues"
  },
  "homepage": "https://github.com/CyberSphinxxx/Quizeasy#readme",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
